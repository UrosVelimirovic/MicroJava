/*----------------------------------------------------------------------------------------------------------------*/

package rs.ac.bg.etf.pp1;

import java_cup.runtime.*;
import org.apache.log4j.*;
import rs.ac.bg.etf.pp1.ast.*;

/*----------------------------------------------------------------------------------------------------------------*/

parser code {:

	boolean errorDetected;
	
	Logger log = Logger.getLogger(getClass());
   
   
    // slede redefinisani metodi za prijavu gresaka radi izmene teksta poruke
     
    public void report_fatal_error(String message, Object info) throws java.lang.Exception {
      done_parsing();
      report_error(message, info);
    }
  
    public void syntax_error(Symbol cur_token) {
        report_error("\nSintaksna greska", cur_token);
    }
  
    public void unrecovered_syntax_error(Symbol cur_token) throws java.lang.Exception {
        report_fatal_error("Fatalna greska, parsiranje se ne moze nastaviti", cur_token);
    }

    public void report_error(String message, Object info) {
    	errorDetected = true;
    	StringBuilder msg = new StringBuilder(message); 
    	if (info instanceof Symbol)
            msg.append (" na liniji ").append(((Symbol)info).left);
        log.error(msg.toString());
    }
    
:}

/*----------------------------------------------------------------------------------------------------------------*/

init with {:
	errorDetected = false;
:}

/*----------------------------------------------------------------------------------------------------------------*/

scan with {:
	Symbol s = this.getScanner().next_token();
	if (s != null && s.value != null) 
		log.info(s.toString() + " " + s.value.toString());
	return s;
:}

/*----------------------------------------------------------------------------------------------------------------*/

terminal PROG;
terminal ELSE;
terminal IF;
terminal BREAK;
terminal CONTINUE;
terminal FOR;
terminal PRINT;
terminal READ;
terminal RETURN;
terminal VOID;
terminal SWITCH;
terminal CASE;
terminal ENUM;
terminal CONST;
terminal NEW;
terminal LENGTH;

terminal PLUS;
terminal MINUS;
terminal MUL;
terminal DIV;
terminal MOD;
terminal EQUALEQUAL;
terminal NOTEQUAL;
terminal BIGGERTHAN;
terminal BIGGEROREQUALTHAN;
terminal SMALLERTHAN;
terminal SMALLEROREQUALTHAN;
terminal ANDAND;
terminal OROR;
terminal EQUAL;
terminal INC;
terminal DEC;

terminal SEMICOLON;
terminal COLON;
terminal COMMA;
terminal DOT;
terminal QUESTIONMARK;
terminal LPAREN;
terminal RPAREN;
terminal LBRACKET;
terminal RBRACKET;
terminal LBRACE;
terminal RBRACE;

terminal String IDENT;
terminal Integer NUMBER;
terminal Integer BOOL;
terminal Character CHARACTER;

/* TODO: oporavak od greske */
/*----------------------------------------------------------------------------------------------------------------*/

nonterminal Program Program;
nonterminal ProgramName ProgramName;
nonterminal ConstVarEnumList ConstVarEnumList;
nonterminal MethodDeclList MethodDeclList;
nonterminal ConstDeclList ConstDeclList;
nonterminal VarDeclList VarDeclList;
nonterminal EnumDeclList EnumDeclList;
nonterminal Type Type;
nonterminal ConstDecl ConstDecl;
nonterminal ConstDeclMore ConstDeclMore;
nonterminal Constant Constant;
nonterminal VarDecl VarDecl;
nonterminal VarDeclMore VarDeclMore;
nonterminal EnumDecl EnumDecl;
nonterminal EnumDeclMore EnumDeclMore;
nonterminal EnumName EnumName;
nonterminal MethodDecl MethodDecl;
nonterminal MethodReturnTypeAndName MethodReturnTypeAndName;
nonterminal VarDeclListInMethod VarDeclListInMethod;
nonterminal FormParsList FormParsList;
nonterminal FormPars FormPars;
nonterminal FormParsMore FormParsMore;
nonterminal Statement Statement;
nonterminal StatementList StatementList;
nonterminal Statements Statements;
nonterminal SingleStatement SingleStatement;
nonterminal ElseStatement ElseStatement;
nonterminal CaseList CaseList;
nonterminal CaseClause CaseClause;
nonterminal ForInit ForInit;
nonterminal ForCondition ForCondition;
nonterminal ForStep ForStep;
nonterminal rs.etf.pp1.symboltable.concepts.Struct Condition;
nonterminal rs.etf.pp1.symboltable.concepts.Struct CondTerm;
nonterminal rs.etf.pp1.symboltable.concepts.Struct CondTermList;
nonterminal rs.etf.pp1.symboltable.concepts.Struct CondFact;
nonterminal rs.etf.pp1.symboltable.concepts.Struct CondFactList;

nonterminal rs.etf.pp1.symboltable.concepts.Struct Expr;
nonterminal rs.etf.pp1.symboltable.concepts.Struct NonTernaryExpr;
nonterminal rs.etf.pp1.symboltable.concepts.Struct TernaryExpr;
nonterminal rs.etf.pp1.symboltable.concepts.Struct Term;
nonterminal rs.etf.pp1.symboltable.concepts.Struct Factor;
nonterminal rs.etf.pp1.symboltable.concepts.Struct AddopTermList;
nonterminal rs.etf.pp1.symboltable.concepts.Struct MulopFactorList;

nonterminal Unary Unary;
nonterminal rs.etf.pp1.symboltable.concepts.Struct FactorSub;

nonterminal ActParsList ActParsList;
nonterminal ActPars ActPars;
nonterminal ActParsMore ActParsMore;

nonterminal DesignatorStatement DesignatorStatement;
nonterminal rs.etf.pp1.symboltable.concepts.Obj Designator;

nonterminal Relop Relop;
nonterminal Addop Addop;
nonterminal Mulop Mulop;

nonterminal rs.etf.pp1.symboltable.concepts.Obj DesignatorArrayName;

nonterminal ForNonTerm ForNonTerm;
nonterminal ActParsListBegin ActParsListBegin;

nonterminal CaseBegin CaseBegin;
/*----------------------------------------------------------------------------------------------------------------*/

precedence left ELSE;

/*----------------------------------------------------------------------------------------------------------------*/

/* Program = "program" ident {ConstDecl | VarDecl | EnumDecl } "{" {MethodDecl} "}" */

Program ::= (Program) PROG ProgramName:P1 ConstVarEnumList:C2 LBRACE MethodDeclList:M3 RBRACE {: RESULT=new Program(P1, C2, M3); RESULT.setLine(P1left); :};

ProgramName ::= (ProgramName) IDENT:I1 {: RESULT=new ProgramName(I1); RESULT.setLine(I1left); :};

/*----------------------------------------------------------------------------------------------------------------*/

ConstVarEnumList ::= (ConstVarEnumList_Const) ConstVarEnumList:C1 ConstDeclList:C2 {: RESULT=new ConstVarEnumList_Const(C1, C2); RESULT.setLine(C1left); :}	
					 |
					 (ConstVarEnumList_Var) ConstVarEnumList:C1 VarDeclList:V2 {: RESULT=new ConstVarEnumList_Var(C1, V2); RESULT.setLine(C1left); :}
					 |
					 (ConstVarEnumList_Enum) ConstVarEnumList:C1 EnumDeclList:E2 {: RESULT=new ConstVarEnumList_Enum(C1, E2); RESULT.setLine(C1left); :}
					 |
					 (ConstVarEnumList_epsilon) {: RESULT=new ConstVarEnumList_epsilon(); :} /* epsilon */
					 ; 

/*----------------------------------------------------------------------------------------------------------------*/

/* ConstDecl = "const" Type ident"="(numConst | charConst | boolConst) {, ident "=" (numConst | charConst | boolConst)} ";" */

ConstDeclList ::= (ConstDeclList) CONST Type:T1 ConstDecl:C2 ConstDeclMore:C3 SEMICOLON {: RESULT=new ConstDeclList(T1, C2, C3); RESULT.setLine(T1left); :};

ConstDecl ::= (ConstDecl) IDENT:I1 EQUAL Constant:C2 {: RESULT=new ConstDecl(I1, C2); RESULT.setLine(I1left); :};

ConstDeclMore ::= (ConstDeclMore_comma) COMMA ConstDecl:C1 ConstDeclMore:C2 {: RESULT=new ConstDeclMore_comma(C1, C2); RESULT.setLine(C1left); :}
				|
				(ConstDeclMore_epsilon) {: RESULT=new ConstDeclMore_epsilon(); :} /* epsilon */
				;

Constant ::= 	(Constant_number) NUMBER:N1 {: RESULT=new Constant_number(N1); RESULT.setLine(N1left); :}
				|
				(Constant_character) CHARACTER:C1 {: RESULT=new Constant_character(C1); RESULT.setLine(C1left); :}
				|
				(Constant_bool) BOOL:B1 {: RESULT=new Constant_bool(B1); RESULT.setLine(B1left); :}
				;
				
/*----------------------------------------------------------------------------------------------------------------*/

/* VarDecl = Type ident ["[" "]"] {"," ident ["[" "]"]} ";" */

VarDeclList ::= (VarDeclList) Type:T1 VarDecl:V2 VarDeclMore:V3 SEMICOLON {: RESULT=new VarDeclList(T1, V2, V3); RESULT.setLine(T1left); :};


VarDecl ::= (VarDecl_var) IDENT:I1 {: RESULT=new VarDecl_var(I1); RESULT.setLine(I1left); :}  
			|
			(VarDecl_array) IDENT:I1 LBRACKET RBRACKET {: RESULT=new VarDecl_array(I1); RESULT.setLine(I1left); :}
			; 


VarDeclMore ::= (VarDeclMore_comma) COMMA VarDecl:V1 VarDeclMore:V2 {: RESULT=new VarDeclMore_comma(V1, V2); RESULT.setLine(V1left); :} 
				|
				(VarDeclMore_epsilon) {: RESULT=new VarDeclMore_epsilon(); :} /* epsilon */
				; 
				
/*----------------------------------------------------------------------------------------------------------------*/

/* EnumDecl = "enum" ident "{" ident ["=" numConst] {"," ident ["=" numConst]} "}" */

EnumDeclList ::= (EnumDeclList) ENUM EnumName:E1 LBRACE EnumDecl:E2 EnumDeclMore:E3 RBRACE {: RESULT=new EnumDeclList(E1, E2, E3); RESULT.setLine(E1left); :};

EnumName ::= (EnumName) IDENT:I1 {: RESULT=new EnumName(I1); RESULT.setLine(I1left); :};

EnumDecl ::= (EnumDecl_var) IDENT:I1 {: RESULT=new EnumDecl_var(I1); RESULT.setLine(I1left); :}
			 |
			 (EnumDecl_equal) IDENT:I1 EQUAL NUMBER:N2 {: RESULT=new EnumDecl_equal(I1, N2); RESULT.setLine(I1left); :} 
			 ;
			 
EnumDeclMore ::= (EnumDeclMore_comma) COMMA EnumDecl:E1 EnumDeclMore:E2 {: RESULT=new EnumDeclMore_comma(E1, E2); RESULT.setLine(E1left); :}
				 |
				 (EnumDeclMore_epsilon) {: RESULT=new EnumDeclMore_epsilon(); :} /* epsilon */
				 ;


/*----------------------------------------------------------------------------------------------------------------*/

/* MethodDecl = (Type | "void") ident "(" [FormPars] ")" {VarDecl} "{" {Statement} "}" */

MethodDeclList ::= 	(MethodDeclList_rec) MethodDeclList:M1  MethodDecl:M2 {: RESULT=new MethodDeclList_rec(M1, M2); RESULT.setLine(M1left); :}
					|
					(MethodDeclList_epsilon) {: RESULT=new MethodDeclList_epsilon(); :} /* epsilon */
					;

MethodDecl ::= (MethodDecl) MethodReturnTypeAndName:M1 LPAREN FormParsList:F2 RPAREN VarDeclListInMethod:V3 LBRACE StatementList:S4 RBRACE {: RESULT=new MethodDecl(M1, F2, V3, S4); RESULT.setLine(M1left); :};

MethodReturnTypeAndName ::= (MethodReturnTypeAndName_Type) Type:T1 IDENT:I2 {: RESULT=new MethodReturnTypeAndName_Type(T1, I2); RESULT.setLine(T1left); :}
							|
							(MethodReturnTypeAndName_void) VOID IDENT:I1 {: RESULT=new MethodReturnTypeAndName_void(I1); RESULT.setLine(I1left); :}
							;

VarDeclListInMethod ::= (VarDeclListInMethod_recursive) VarDeclListInMethod:V1 VarDeclList:V2 {: RESULT=new VarDeclListInMethod_recursive(V1, V2); RESULT.setLine(V1left); :}
						|
						(VarDeclListRec_epsilon) {: RESULT=new VarDeclListRec_epsilon(); :} /* epsilon */
						;
					
/*----------------------------------------------------------------------------------------------------------------*/

/* FormPars = Type ident ["[" "]"] {"," Type ident ["[" "]"]} */

FormParsList ::= 	(FormParsList_recursive) FormPars:F1 FormParsMore:F2 {: RESULT=new FormParsList_recursive(F1, F2); RESULT.setLine(F1left); :}
					|
					(FormParsList_epsilon) {: RESULT=new FormParsList_epsilon(); :} /* epsilon */
					;
					
FormPars ::= (FormPars_var) Type:T1 IDENT:I2 {: RESULT=new FormPars_var(T1, I2); RESULT.setLine(T1left); :}  
		     |
			 (FormPars_array) Type:T1 IDENT:I2 LBRACKET RBRACKET {: RESULT=new FormPars_array(T1, I2); RESULT.setLine(T1left); :}
			 ; 

FormParsMore ::= (FormParsMore_comma) COMMA FormPars:F1 FormParsMore:F2 {: RESULT=new FormParsMore_comma(F1, F2); RESULT.setLine(F1left); :}
				 |
				 (FormParsMore_epsilon) {: RESULT=new FormParsMore_epsilon(); :} /* epsilon */
				 ;
				
/*----------------------------------------------------------------------------------------------------------------*/

Type ::= (Type) IDENT:I1 {: RESULT=new Type(I1); RESULT.setLine(I1left); :};

/*----------------------------------------------------------------------------------------------------------------*/

/*
			Statement = DesignatorStatement ";"
			| "if" "(" Condition ")" Statement ["else" Statement]
			| "break" ";"
			| "continue" ";"
			| "return" [Expr] ";"
			| "read" "(" Designator ")" ";"
			| "print" "(" Expr ["," numConst] ")" ";"
			| "switch" "(" Expr ")" "{" {"case" numConst ":" {Statement} } "}"
			| "for" "(" [DesignatorStatement] ";" [Condition] ";" [DesignatorStatement] ")" Statement
			| "{" {Statement} "}".
*/

StatementList ::= 	(StatementList_recursive) StatementList:S1 Statement:S2 {: RESULT=new StatementList_recursive(S1, S2); RESULT.setLine(S1left); :}
				   	|										   
				  	(StatementList_epsilon) {: RESULT=new StatementList_epsilon(); :} /* epsilon */
				   	;

Statement ::= (Statement_SingleStatement) SingleStatement:S1 {: RESULT=new Statement_SingleStatement(S1); RESULT.setLine(S1left); :}
			  |
			  (Statement_s) Statements:S1 {: RESULT=new Statement_s(S1); RESULT.setLine(S1left); :}
			  ;

Statements ::= (Statements) LBRACE StatementList:S1 RBRACE {: RESULT=new Statements(S1); RESULT.setLine(S1left); :};

SingleStatement ::= (SingleStatement_ds) DesignatorStatement:D1 SEMICOLON {: RESULT=new SingleStatement_ds(D1); RESULT.setLine(D1left); :}
					|
					(SingleStatement_if) IF LPAREN Condition:C1 RPAREN Statement:S2 ElseStatement:E3 {: RESULT=new SingleStatement_if(C1, S2, E3); RESULT.setLine(C1left); :}
					|					
					(SingleStatement_break) BREAK SEMICOLON {: RESULT=new SingleStatement_break(); :}
					|
					(SingleStatement_continue) CONTINUE SEMICOLON {: RESULT=new SingleStatement_continue(); :}
					|
					(SingleStatement_returnSemiColon) RETURN SEMICOLON {: RESULT=new SingleStatement_returnSemiColon(); :}
			  		|
			  		(SingleStatement_returnExpr) RETURN Expr:E1 SEMICOLON {: RESULT=new SingleStatement_returnExpr(E1); RESULT.setLine(E1left); :}
			  		|
			  		(SingleStatement_read) READ LPAREN Designator:D1 RPAREN SEMICOLON {: RESULT=new SingleStatement_read(D1); RESULT.setLine(D1left); :}
			  		|
			  		(SingleStatement_print1) PRINT LPAREN Expr:E1 RPAREN SEMICOLON {: RESULT=new SingleStatement_print1(E1); RESULT.setLine(E1left); :}
			  		|
			  		(SingleStatement_print2) PRINT LPAREN Expr:E1 COMMA NUMBER:N2 RPAREN SEMICOLON {: RESULT=new SingleStatement_print2(E1, N2); RESULT.setLine(E1left); :}
					|
					(SingleStatement_switch) SWITCH LPAREN Expr:E1 RPAREN LBRACE CaseList:C2 RBRACE {: RESULT=new SingleStatement_switch(E1, C2); RESULT.setLine(E1left); :}
					|
					(SingleStatement_for) ForNonTerm:F1 LPAREN ForInit:F2 SEMICOLON ForCondition:F3 SEMICOLON ForStep:F4 RPAREN Statement:S5 {: RESULT=new SingleStatement_for(F1, F2, F3, F4, S5); RESULT.setLine(F1left); :}
					;

ForNonTerm ::= (ForNonTerm) FOR {: RESULT=new ForNonTerm(); :};

/*----------------------------------------------------------------------------------------------------------------*/

ElseStatement ::= 	(ElseStatement_yes) ELSE Statement:S1 {: RESULT=new ElseStatement_yes(S1); RESULT.setLine(S1left); :}
					|
					(ElseStatement_no) {: RESULT=new ElseStatement_no(); :} /* epsilon */
					;

/*----------------------------------------------------------------------------------------------------------------*/
					
CaseList ::= (CaseList_recursive) CaseList:C1 CaseClause:C2 {: RESULT=new CaseList_recursive(C1, C2); RESULT.setLine(C1left); :}
			 |
			 (CaseList_epsilon) {: RESULT=new CaseList_epsilon(); :} /* epsilon */
			 ;

CaseClause ::= (CaseClause) CaseBegin:C1 NUMBER:N2 COLON StatementList:S3 {: RESULT=new CaseClause(C1, N2, S3); RESULT.setLine(C1left); :};

CaseBegin ::= (CaseBegin) CASE {: RESULT=new CaseBegin(); :};
			   
/*----------------------------------------------------------------------------------------------------------------*/

ForInit ::= (ForInit_DesignatorStatement) DesignatorStatement:D1 {: RESULT=new ForInit_DesignatorStatement(D1); RESULT.setLine(D1left); :}
			|
			(ForInit_epsilon) {: RESULT=new ForInit_epsilon(); :} /* epsilon */
			;

ForCondition ::= (ForCondition_Condition) Condition:C1 {: RESULT=new ForCondition_Condition(C1); RESULT.setLine(C1left); :}
				 |
				 (ForCondition_epsilon) {: RESULT=new ForCondition_epsilon(); :} /* epsilon */
				 ;

ForStep ::= (ForStep_DesignatorStatement) DesignatorStatement:D1 {: RESULT=new ForStep_DesignatorStatement(D1); RESULT.setLine(D1left); :}
		    |
		    (ForStep_epsilon) {: RESULT=new ForStep_epsilon(); :} /* epsilon */
		    ;
		    
/*----------------------------------------------------------------------------------------------------------------*/

/* Condition = CondTerm {"||" CondTerm} */

Condition ::= (Condition) CondTermList:C1 {: RESULT=new Condition(C1); RESULT.setLine(C1left); :};

CondTermList ::= 	(CondTermList_or) CondTermList:C1 OROR CondTerm:C2 {: RESULT=new CondTermList_or(C1, C2); RESULT.setLine(C1left); :}
				 	|
					(CondTermList_ct) CondTerm:C1 {: RESULT=new CondTermList_ct(C1); RESULT.setLine(C1left); :}
					;
/*----------------------------------------------------------------------------------------------------------------*/

/* CondTerm = CondFact {"&&" CondFact} */

CondTerm ::= (CondTerm) CondFactList:C1 {: RESULT=new CondTerm(C1); RESULT.setLine(C1left); :};
			 
/*----------------------------------------------------------------------------------------------------------------*/

/* CondFact = Expr [Relop Expr] */

CondFactList ::= 	(CondFactList_and) CondFactList:C1 ANDAND CondFact:C2 {: RESULT=new CondFactList_and(C1, C2); RESULT.setLine(C1left); :} 
				 	|
					(CondFactList_condfact) CondFact:C1 {: RESULT=new CondFactList_condfact(C1); RESULT.setLine(C1left); :}
					;
					
CondFact ::= 	(CondFact_expr) NonTernaryExpr:N1 {: RESULT=new CondFact_expr(N1); RESULT.setLine(N1left); :}
				| 
				(CondFact_expr_relop_expr) NonTernaryExpr:N1 Relop:R2 NonTernaryExpr:N3 {: RESULT=new CondFact_expr_relop_expr(N1, R2, N3); RESULT.setLine(N1left); :}
				;	
				
/*----------------------------------------------------------------------------------------------------------------*/
				
/* DesignatorStatement = Designator (Assignop Expr | "(" [ActPars] ")" | "++" | "‐‐") */

DesignatorStatement ::= (DesignatorStatement_assign) Designator:D1 EQUAL Expr:E2 {: RESULT=new DesignatorStatement_assign(D1, E2); RESULT.setLine(D1left); :}
						|
						(DesignatorStatement_meth) Designator:D1 LPAREN ActParsList:A2 RPAREN {: RESULT=new DesignatorStatement_meth(D1, A2); RESULT.setLine(D1left); :} 
						|
						(DesignatorStatement_inc) Designator:D1 INC {: RESULT=new DesignatorStatement_inc(D1); RESULT.setLine(D1left); :}
						|
						(DesignatorStatement_dec) Designator:D1 DEC {: RESULT=new DesignatorStatement_dec(D1); RESULT.setLine(D1left); :}
						;

/*----------------------------------------------------------------------------------------------------------------*/

/* Designator = ident {"." ( ident | "length") | "[" Expr "]"} */

/*
 Vrste:
    0 varName (includes niz)
 	2 enumName.ident
 	4 niz[expr]
 	5 niz.length
*/

Designator ::= 	(Designator_var) IDENT:I1 {: RESULT=new Designator_var(I1); RESULT.setLine(I1left); :} /* 0 3 */	
				|
				(Designator_enumdotident) IDENT:I1 DOT IDENT:I2 {: RESULT=new Designator_enumdotident(I1, I2); RESULT.setLine(I1left); :}	/* 2 */	
				|
				(Designator_elem) DesignatorArrayName:D1 LBRACKET Expr:E2 RBRACKET {: RESULT=new Designator_elem(D1, E2); RESULT.setLine(D1left); :} /* 4 */
				|
				(Designator_arraylength) IDENT:I1 DOT LENGTH {: RESULT=new Designator_arraylength(I1); RESULT.setLine(I1left); :}	/* 5 */			
				;

DesignatorArrayName ::= (DesignatorArrayName) IDENT:I1 {: RESULT=new DesignatorArrayName(I1); RESULT.setLine(I1left); :};

/*----------------------------------------------------------------------------------------------------------------*/

/*		
		Expr = ["-"] Term {Addop Term} 			!!!ATTENTION!!! THIS "-" SIGN IS IN WRONG PLACE IN PROJECT DESCRIPTION!!!
				| CondFact "?" Expr ":" Expr * za A nivo
				| Condition "?" Expr ":" Expr * za B i C nivo
*/

Expr ::= (Expr_NonTernary) NonTernaryExpr:N1 {: RESULT=new Expr_NonTernary(N1); RESULT.setLine(N1left); :}
		 |
		 (Expr_Ternary) TernaryExpr:T1 {: RESULT=new Expr_Ternary(T1); RESULT.setLine(T1left); :}
		 ;
		 
NonTernaryExpr ::= (NonTernaryExpr) AddopTermList:A1 {: RESULT=new NonTernaryExpr(A1); RESULT.setLine(A1left); :};

TernaryExpr ::= (TernaryExpr) Condition:C1 QUESTIONMARK Expr:E2 COLON Expr:E3 {: RESULT=new TernaryExpr(C1, E2, E3); RESULT.setLine(C1left); :};

/*
						Expr ::= (Expr)  AddopTermList
								 |
								 (Expr_ternaryCondition) Condition QUESTIONMARK Expr COLON Expr
								 ;
*/
		 
AddopTermList ::= 	(AddopTermList_add) AddopTermList:A1 Addop:A2 Term:T3 {: RESULT=new AddopTermList_add(A1, A2, T3); RESULT.setLine(A1left); :}
					|
					(AddopTermList_term) Term:T1 {: RESULT=new AddopTermList_term(T1); RESULT.setLine(T1left); :}
					;
              
/*----------------------------------------------------------------------------------------------------------------*/

/* Term = Factor {Mulop Factor} */

Term ::= (Term) MulopFactorList:M1 {: RESULT=new Term(M1); RESULT.setLine(M1left); :};

MulopFactorList ::= (MulopFactorList_mul) MulopFactorList:M1 Mulop:M2 Factor:F3 {: RESULT=new MulopFactorList_mul(M1, M2, F3); RESULT.setLine(M1left); :}
					|
					(MulopFactorList_factor) Factor:F1 {: RESULT=new MulopFactorList_factor(F1); RESULT.setLine(F1left); :}
					;

/*----------------------------------------------------------------------------------------------------------------*/

/*
	Factor = Designator ["(" [ActPars] ")"]
			| numConst
			| charConst
			| boolConst
			| "new" Type [ "[" Expr "]" ]
			| "(" Expr ")".
*/
					
Factor ::= (Factor) Unary:U1 FactorSub:F2 {: RESULT=new Factor(U1, F2); RESULT.setLine(U1left); :};

FactorSub ::= 	(FactorSub_var) Designator:D1 {: RESULT=new FactorSub_var(D1); RESULT.setLine(D1left); :}
				|
				(FactorSub_meth) Designator:D1 LPAREN ActParsList:A2 RPAREN {: RESULT=new FactorSub_meth(D1, A2); RESULT.setLine(D1left); :}
		   		|
		   		(FactorSub_n) NUMBER:N1 {: RESULT=new FactorSub_n(N1); RESULT.setLine(N1left); :}
		   		|
		   		(FactorSub_c) CHARACTER:C1 {: RESULT=new FactorSub_c(C1); RESULT.setLine(C1left); :}
		   		|
		   		(FactorSub_b) BOOL:B1 {: RESULT=new FactorSub_b(B1); RESULT.setLine(B1left); :}
		   		|		   
		   		(FactorSub_new_array) NEW Type:T1 LBRACKET Expr:E2 RBRACKET {: RESULT=new FactorSub_new_array(T1, E2); RESULT.setLine(T1left); :}
		   		|
		   		(FactorSub_expr) LPAREN Expr:E1 RPAREN {: RESULT=new FactorSub_expr(E1); RESULT.setLine(E1left); :}
		   		;
		   		
Unary ::= 	(Unary_minus) MINUS {: RESULT=new Unary_minus(); :}
			|
			(Unary_epsilon) {: RESULT=new Unary_epsilon(); :} /* epsilon */
			;
			
/*----------------------------------------------------------------------------------------------------------------*/

/* ActPars = Expr {"," Expr} */

ActParsList ::= 	(ActParsList_rec) ActParsListBegin:A1 ActPars:A2 ActParsMore:A3 {: RESULT=new ActParsList_rec(A1, A2, A3); RESULT.setLine(A1left); :}
					|
					(ActParsList_epsilon) ActParsListBegin:A1 {: RESULT=new ActParsList_epsilon(A1); RESULT.setLine(A1left); :}
					;
					
ActParsListBegin ::= (ActParsListBegin) {: RESULT=new ActParsListBegin(); :} /* epsilon */;

ActParsMore ::= 	(ActParsMore_comma) COMMA ActPars:A1 ActParsMore:A2 {: RESULT=new ActParsMore_comma(A1, A2); RESULT.setLine(A1left); :}
					|
					(ActParsMore_epsilon) {: RESULT=new ActParsMore_epsilon(); :} /* epsilon */
					;
				
ActPars ::= (ActPars) Expr:E1 {: RESULT=new ActPars(E1); RESULT.setLine(E1left); :};

/*----------------------------------------------------------------------------------------------------------------*/

/* Addop = "+" | "‐" */

Addop ::= (Addop_plus) PLUS {: RESULT=new Addop_plus(); :}
		  |
		  (Addop_minus) MINUS {: RESULT=new Addop_minus(); :}
		  ;
		  
/*----------------------------------------------------------------------------------------------------------------*/

/* Relop = "==" | "!=" | ">" | ">=" | "<" | "<=" */

Relop::=	(Relop_eq) EQUALEQUAL {: RESULT=new Relop_eq(); :}
			|
			(Relop_ne) NOTEQUAL {: RESULT=new Relop_ne(); :}
			|
			(Relop_gt) BIGGERTHAN {: RESULT=new Relop_gt(); :}
			|
			(Relop_ge) BIGGEROREQUALTHAN {: RESULT=new Relop_ge(); :}
			|
			(Relop_lt) SMALLERTHAN {: RESULT=new Relop_lt(); :}
			|
			(Relop_le) SMALLEROREQUALTHAN {: RESULT=new Relop_le(); :}
			;
			
/*----------------------------------------------------------------------------------------------------------------*/

/* Mulop = "*" | "/" | "%". */

Mulop ::= (Mulop_mul) MUL {: RESULT=new Mulop_mul(); :}
		  |		  
		  (Mulop_div) DIV {: RESULT=new Mulop_div(); :}
		  |
		  (Mulop_rem) MOD {: RESULT=new Mulop_rem(); :}
		  ;
		  
/*----------------------------------------------------------------------------------------------------------------*/






